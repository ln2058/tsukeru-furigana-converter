{
  "manifest_version": 3,
  "name": "__MSG_manifest_name__",
  "version": "4.1.0",
  "description": "__MSG_manifest_description__",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.ezfurigana.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/i18n.js",
        "js/ui-messages.js",
        "js/content-ui.js",
        "js/content-rate-limit.js",
        "js/content-dom.js",
        "js/tooltip-async-state.js",
        "js/word-rules.js",
        "js/content-tooltip.js",
        "js/content-main.js"
      ],
      "css": [
        "content.css"
      ]
    },
    {
      "matches": [
        "https://www.ezfurigana.com/*"
      ],
      "js": [
        "js/content-sync.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-furigana": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z",
        "mac": "Command+Shift+Z"
      },
      "description": "__MSG_command_toggle_furigana_description__"
    }
  }
}
